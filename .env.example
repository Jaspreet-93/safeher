# ==============================================================================
# SafeHer Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC CREDENTIALS
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL KEYS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=SafeHer
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=insecure-dev-secret-key-change-in-production-min-32-chars-long

# ------------------------------------------------------------------------------
# HOSTS & NETWORKING
# ------------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 16 with PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=safeher_user
POSTGRES_PASSWORD=safeher_password
POSTGRES_DB=safeher_db
DATABASE_URL=postgresql+asyncpg://safeher_user:safeher_password@localhost:5432/safeher_db
# For Docker Compose internal networking:
# DATABASE_URL=postgresql+asyncpg://safeher_user:safeher_password@postgres:5432/safeher_db

# ------------------------------------------------------------------------------
# CACHE & BROKER (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
# For Docker Compose internal networking:
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# ------------------------------------------------------------------------------
# INTEGRATION PROVIDERS (Defaults to MOCK for safe local development & testing)
# ------------------------------------------------------------------------------
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
EMAIL_PROVIDER=mock
MAPS_PROVIDER=mock
PAYMENTS_PROVIDER=mock
LLM_PROVIDER=mock

# Twilio / Fast2SMS credentials (Required in production)
SMS_API_KEY=
SMS_SENDER_ID=SAFEHR
SMS_DLT_ENTITY_ID=

# S3 / Object Storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=safeher-attachments
S3_REGION=ap-south-1

# Razorpay Payments (Production only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Emergency Fallback Number (India ERSS)
EMERGENCY_NUMBER_PRIMARY=112
